# 本地 / Compose 环境变量示例。复制为 .env 后按需修改，不要提交真实密钥。
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=blog
DB_PORT=5432

REDIS_PORT=6379

ADMIN_EMAIL=admin@blog.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TZ=Asia/Shanghai

# 若拉取 Docker Hub 超时，取消下面注释改用镜像加速（DaoCloud 示例）：
# JDK_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jdk-alpine
# JRE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:17-alpine
# REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
# MINIO_IMAGE=docker.m.daocloud.io/minio/minio:latest

# 媒体：pnpm dev 默认走 MinIO（MEDIA_STORAGE_TYPE=s3）。测试与未设变量时仍用本地目录。
MEDIA_STORAGE_TYPE=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=blog-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
